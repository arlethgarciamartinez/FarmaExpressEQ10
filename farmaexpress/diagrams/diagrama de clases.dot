digraph clases {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=16, nodesep=0.25, ranksep=1.2, splines=true, compound=true, pad=0.3, labelloc=t, label="FarmaExpress — Diagrama de clases por capas (proceso: venta en mostrador + retiro de lote + resurtido)"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=9, color="#334155"];
  subgraph cluster_app { label=<<B>APLICACIÓN  (Service Layer · Commands/Queries · Puertos)</B>>; style="rounded,filled"; fillcolor="#ffedd533"; color="#c2410c"; penwidth=2; fontsize=14;
  VentaMostradorService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Application Service&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>VentaMostradorService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ iniciar_venta()<BR ALIGN="LEFT"/>+ agregar_producto()<BR ALIGN="LEFT"/>+ aceptar_sustituto()<BR ALIGN="LEFT"/>+ registrar_receta()<BR ALIGN="LEFT"/>+ confirmar_cobro()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  AutorizacionDeVentaService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Application Service&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>AutorizacionDeVentaService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ otorgar()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  RetiroDeLoteService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Application Service&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RetiroDeLoteService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ registrar_retiro()<BR ALIGN="LEFT"/>+ notificar_a_almacen()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  ResurtidoService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Application Service&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ResurtidoService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ generar_alerta_de_resurtido()<BR ALIGN="LEFT"/>+ generar_orden_de_compra()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  ConsultarDisponibilidadEnSucursalesHandler [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Query Handler&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ConsultarDisponibilidadEnSucursalesHandler</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ manejar() : DisponibilidadEnSucursalDTO[]<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  ConsultarCaducidadesProximasHandler [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Query Handler&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ConsultarCaducidadesProximasHandler</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ manejar() : CaducidadProximaDTO[]<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  UnidadDeTrabajo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · puerto&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>UnidadDeTrabajo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ confirmar()<BR ALIGN="LEFT"/>ventas, lotes, inventarios,<BR ALIGN="LEFT"/>productos, alertas, ordenes<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  NotificadorDeAlmacen [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · puerto&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>NotificadorDeAlmacen</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ notificar_recoleccion_de_lote()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  LecturaDeInventario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · puerto de lectura&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>LecturaDeInventario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ existencia_en_otras_sucursales()<BR ALIGN="LEFT"/>+ lotes_con_existencia()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Reloj [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c2410c" BGCOLOR="#ffedd5"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · puerto&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Reloj</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ hoy() : date<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_dom { label=<<B>DOMINIO  (Aggregates · Value Objects · Domain Service · Repositorios · Eventos)</B>>; style="rounded,filled"; fillcolor="#dbeafe33"; color="#1d4ed8"; penwidth=2; fontsize=14;
  Venta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Aggregate Root&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Venta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ agregar_producto()<BR ALIGN="LEFT"/>+ agregar_sustituto()<BR ALIGN="LEFT"/>+ registrar_receta()<BR ALIGN="LEFT"/>+ otorgar_autorizacion()<BR ALIGN="LEFT"/>+ confirmar_cobro() : Ticket<BR ALIGN="LEFT"/>+ rechazar(motivo)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  LineaDeVenta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Entity&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>LineaDeVenta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ subtotal() : Dinero<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Receta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Value Object&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Receta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ faltantes()<BR ALIGN="LEFT"/>+ esta_vigente(hoy)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Autorizacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Value Object&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Autorizacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tipo, autorizado_por, rol<BR ALIGN="LEFT"/>(sólo Responsable de farmacia)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Ticket [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Value Object&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Ticket</B></TD></TR></TABLE>>];
  LimitesDeVentaControlada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Value Object&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>LimitesDeVentaControlada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ excede(piezas, monto)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Lote [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Aggregate Root&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Lote</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ verificar_vendible(hoy)<BR ALIGN="LEFT"/>+ marcar_caducado(hoy)<BR ALIGN="LEFT"/>+ retirar(motivo, Autorizacion)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  InventarioDeProducto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Aggregate Root&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>InventarioDeProducto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ descontar(lote, cantidad)<BR ALIGN="LEFT"/>+ recibir(lote, cantidad)<BR ALIGN="LEFT"/>+ cantidad_a_resurtir()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  NivelesDeInventario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Value Object&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>NivelesDeInventario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">minimo, maximo<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Producto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Aggregate Root&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Producto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ admite_como_sustituto(Sku)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  AlertaDeResurtido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Aggregate Root&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>AlertaDeResurtido</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ marcar_atendida()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  OrdenDeCompra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Aggregate Root&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>OrdenDeCompra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ agregar_desde_alerta()<BR ALIGN="LEFT"/>+ confirmar()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  SeleccionDeLote [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Domain Service&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>SeleccionDeLote</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ seleccionar(inventario, lotes,<BR ALIGN="LEFT"/>   cantidad, hoy) : NumeroDeLote<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  PoliticaDeOrdenDeLotes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>PoliticaDeOrdenDeLotes</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ ordenar(lotes)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  PrimeroEnCaducarPrimeroEnSalir [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;FEFO · supuesto&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>PrimeroEnCaducarPrimeroEnSalir</B></TD></TR></TABLE>>];
  RepositorioDeVentas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · Repository&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RepositorioDeVentas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ siguiente_id(), agregar(), obtener()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  RepositorioDeLotes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · Repository&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RepositorioDeLotes</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ obtener(), de_producto(), agregar()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  RepositorioDeInventario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · Repository&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RepositorioDeInventario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ obtener(sucursal, sku), agregar()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  RepositorioDeProductos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · Repository&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RepositorioDeProductos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ obtener(sku)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  RepositorioDeAlertas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · Repository&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RepositorioDeAlertas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ pendientes_de_proveedor()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  RepositorioDeOrdenesDeCompra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;interface · Repository&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RepositorioDeOrdenesDeCompra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ agregar(), obtener()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  VentaCobrada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Domain Event&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>VentaCobrada</B></TD></TR></TABLE>>];
  ExistenciaBajoMinimo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Domain Event&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ExistenciaBajoMinimo</B></TD></TR></TABLE>>];
  LoteRetirado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d4ed8" BGCOLOR="#dbeafe"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;Domain Event&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>LoteRetirado</B></TD></TR></TABLE>>];
  }
  subgraph cluster_inf { label=<<B>INFRAESTRUCTURA  (implementaciones; en producción: SQL/ORM, bus, correo)</B>>; style="rounded,filled"; fillcolor="#e5e7eb33"; color="#4b5563"; penwidth=2; fontsize=14;
  UnidadDeTrabajoEnMemoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4b5563" BGCOLOR="#e5e7eb"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9"><I>&laquo;implementa&raquo;</I></FONT></TD></TR><TR><TD ALIGN="CENTER"><B>UnidadDeTrabajoEnMemoria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">BEGIN: instantánea<BR ALIGN="LEFT"/>confirmar(): commit + publicar<BR ALIGN="LEFT"/>__exit__ sin commit: rollback<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  RepositorioDeVentasEnMemoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4b5563" BGCOLOR="#e5e7eb"><TR><TD ALIGN="CENTER"><B>RepositorioDeVentasEnMemoria</B></TD></TR></TABLE>>];
  RepositorioDeLotesEnMemoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4b5563" BGCOLOR="#e5e7eb"><TR><TD ALIGN="CENTER"><B>RepositorioDeLotesEnMemoria</B></TD></TR></TABLE>>];
  RepositorioDeInventarioEnMemoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4b5563" BGCOLOR="#e5e7eb"><TR><TD ALIGN="CENTER"><B>RepositorioDeInventarioEnMemoria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">(+ 3 repositorios análogos)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  BusDeEventosEnMemoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4b5563" BGCOLOR="#e5e7eb"><TR><TD ALIGN="CENTER"><B>BusDeEventosEnMemoria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ suscribir(), publicar()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  NotificadorDeAlmacenEnMemoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4b5563" BGCOLOR="#e5e7eb"><TR><TD ALIGN="CENTER"><B>NotificadorDeAlmacenEnMemoria</B></TD></TR></TABLE>>];
  LecturaDeInventarioEnMemoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4b5563" BGCOLOR="#e5e7eb"><TR><TD ALIGN="CENTER"><B>LecturaDeInventarioEnMemoria</B></TD></TR></TABLE>>];
  }
  VentaMostradorService -> UnidadDeTrabajo [style=dashed, arrowhead=vee];
  AutorizacionDeVentaService -> UnidadDeTrabajo [style=dashed, arrowhead=vee];
  RetiroDeLoteService -> UnidadDeTrabajo [style=dashed, arrowhead=vee];
