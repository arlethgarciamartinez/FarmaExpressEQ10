  UnidadDeTrabajo -> RepositorioDeInventario [arrowhead=odiamond];
  UnidadDeTrabajo -> RepositorioDeProductos [arrowhead=odiamond];
  UnidadDeTrabajo -> RepositorioDeAlertas [arrowhead=odiamond];
