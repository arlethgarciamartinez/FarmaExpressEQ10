  Venta -> Autorizacion [arrowhead=diamond, label="0..*"];
  Venta -> Ticket [arrowhead=diamond, label="0..1"];
  Venta -> LimitesDeVentaControlada [style=dashed, arrowhead=vee, label="valida con"];
  Venta -> VentaCobrada [style=dotted, arrowhead=vee, label=emite, color="#b45309"];
  Lote -> Autorizacion [style=dashed, arrowhead=vee, label=exige];
  Lote -> LoteRetirado [style=dotted, arrowhead=vee, label=emite, color="#b45309"];
  InventarioDeProducto -> NivelesDeInventario [arrowhead=diamond];
  InventarioDeProducto -> ExistenciaBajoMinimo [style=dotted, arrowhead=vee, label=emite, color="#b45309"];
  OrdenDeCompra -> AlertaDeResurtido [style=dashed, arrowhead=vee, label=agrupa];
  SeleccionDeLote -> Lote [style=dashed, arrowhead=vee];
  SeleccionDeLote -> InventarioDeProducto [style=dashed, arrowhead=vee];
  SeleccionDeLote -> PoliticaDeOrdenDeLotes [style=dashed, arrowhead=vee];
  PoliticaDeOrdenDeLotes -> PrimeroEnCaducarPrimeroEnSalir [dir=back, arrowtail=empty, style=dashed];
