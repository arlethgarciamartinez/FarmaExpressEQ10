  RepositorioDeAlertas -> AlertaDeResurtido [style=dashed, arrowhead=vee, label="guarda/recupera"];
  RepositorioDeOrdenesDeCompra -> OrdenDeCompra [style=dashed, arrowhead=vee, label="guarda/recupera"];
  UnidadDeTrabajo -> UnidadDeTrabajoEnMemoria [dir=back, arrowtail=empty, style=dashed];
  RepositorioDeVentas -> RepositorioDeVentasEnMemoria [dir=back, arrowtail=empty, style=dashed];
  RepositorioDeLotes -> RepositorioDeLotesEnMemoria [dir=back, arrowtail=empty, style=dashed];
  RepositorioDeInventario -> RepositorioDeInventarioEnMemoria [dir=back, arrowtail=empty, style=dashed];
  NotificadorDeAlmacen -> NotificadorDeAlmacenEnMemoria [dir=back, arrowtail=empty, style=dashed];
  LecturaDeInventario -> LecturaDeInventarioEnMemoria [dir=back, arrowtail=empty, style=dashed];
  UnidadDeTrabajoEnMemoria -> BusDeEventosEnMemoria [style=dashed, arrowhead=vee, label="publica tras commit"];
}